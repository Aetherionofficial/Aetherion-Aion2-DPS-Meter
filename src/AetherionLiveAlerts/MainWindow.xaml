<Window x:Class="AetherionLiveAlerts.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aetherion Live" Width="1120" Height="760" MinWidth="900" MinHeight="600" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="AETHERION LIVE" Foreground="{StaticResource Orange}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Live-Alerts, Geschenkziele und OBS-Overlay · unabhängig vom DPS Meter" Foreground="{StaticResource Muted}" Margin="0,6,0,20"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="VERBINDUNG" Foreground="{StaticResource Orange}" FontWeight="Bold"/><CheckBox x:Name="Enabled" Content="Live-Alerts aktivieren"/><TextBlock Text="TikTok-Benutzername" Foreground="{StaticResource Muted}"/><TextBox x:Name="Username"/><TextBlock Text="Webhook-Adresse" Foreground="{StaticResource Muted}"/><TextBox x:Name="Webhook"/><TextBlock Text="Secret wird aus AETHERION_TIKTOK_CLIENT_SECRET gelesen." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/><CheckBox x:Name="Speech" Content="TTS bei Alerts verwenden"/>
    <TextBlock Text="Alert-Sound" Foreground="{StaticResource Muted}"/><ComboBox x:Name="SoundBox"><ComboBoxItem Content="Aetherion"/><ComboBoxItem Content="System"/><ComboBoxItem Content="Stumm"/></ComboBox><TextBlock Text="Spam-Schutz (Sekunden)" Foreground="{StaticResource Muted}"/><TextBox x:Name="CooldownBox"/>
    <Separator Margin="0,8"/><TextBlock Text="GESCHENKZIEL" Foreground="{StaticResource Orange}" FontWeight="Bold"/><TextBox x:Name="GoalName"/><TextBlock Text="Zielmenge" Foreground="{StaticResource Muted}"/><TextBox x:Name="GoalTarget"/><TextBlock Text="Aktueller Stand" Foreground="{StaticResource Muted}"/><TextBox x:Name="GoalCurrent"/>
    <Separator Margin="0,8"/><TextBlock Text="OBS-OVERLAY" Foreground="{StaticResource Orange}" FontWeight="Bold"/><CheckBox x:Name="OverlayEnabled" Content="Overlay-Server aktivieren"/><TextBlock Text="Browser-Quelle" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OverlayUrl" Foreground="{StaticResource Text}" TextWrapping="Wrap" FontSize="11"/><Button Content="Einstellungen speichern" Click="Save_Click" Background="{StaticResource Orange}" Foreground="#160E0A" Margin="0,12,0,0"/><Button Content="Test-Alert auslösen" Click="Test_Click"/><TextBlock x:Name="Status" Text="Bereit" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></Border>
   <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ALERT-REGELN" Foreground="{StaticResource Orange}" FontWeight="Bold"/><ListBox x:Name="Rules" Grid.Row="1" Margin="0,12" Background="#151315" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Width="180"/><TextBlock Text="{Binding EventType}" Foreground="{StaticResource Muted}" Width="100"/><TextBlock Text="{Binding Template}" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="2" Background="#151315" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Event" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox x:Name="TypeBox" Grid.Column="1" SelectionChanged="RuleField_Changed"/><TextBlock Text="Mindestmenge" Grid.Column="2" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBox x:Name="QuantityBox" Grid.Column="3" TextChanged="RuleField_Changed"/><TextBlock Text="Suchbegriff" Grid.Row="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBox x:Name="MatchBox" Grid.Row="1" Grid.Column="1" TextChanged="RuleField_Changed"/><CheckBox x:Name="RuleEnabled" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Regel aktiv" Checked="RuleField_Changed" Unchecked="RuleField_Changed"/><TextBlock Text="Nachricht" Grid.Row="2" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/><TextBox x:Name="TemplateBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" TextChanged="RuleField_Changed"/></Grid></Border>
    <TextBlock Grid.Row="3" Text="EVENT-VERLAUF · Top-Gifter und eingehende Events" Foreground="{StaticResource Orange}" FontWeight="Bold" Margin="0,0,0,8"/><ListBox x:Name="History" Grid.Row="3" Margin="0,28,0,0" Background="#151315" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/><StackPanel Grid.Row="4" Orientation="Horizontal"><Button Content="Regel hinzufügen" Click="Add_Click"/><Button Content="Regel löschen" Click="Remove_Click"/><Button Content="Änderungen speichern" Click="SaveRule_Click"/></StackPanel>
   </Grid></Border></Grid><TextBlock x:Name="Footer" Grid.Row="2" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
 </Grid>
</Window>
