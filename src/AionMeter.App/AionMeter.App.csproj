<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AionMeter.Core\AionMeter.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AION2DpsMeter</AssemblyName>
    <RootNamespace>AionMeter.App</RootNamespace>
    <Product>Aetherion</Product>
    <AssemblyTitle>Aetherion — AION 2 DPS Meter</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.3.40</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- The owner-only offline license signer must never be part of player builds. -->
  <PropertyGroup Condition="'$(AetherionOwnerBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);AETHERION_OWNER_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(AetherionOwnerBuild)' != 'true'">
    <Compile Remove="Windows\KeyIssuerWindow.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, Brush... keep WinForms explicit (tray icon only). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\data\**\*" LogicalName="AionMeter.Data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
