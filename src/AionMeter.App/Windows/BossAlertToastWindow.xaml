<Window x:Class="AionMeter.App.Windows.BossAlertToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="Segoe UI" Foreground="White">
    <Border Width="390" Padding="18,15,16,16" CornerRadius="14"
            Background="#F0191D22" BorderBrush="#CCB99358" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="21" Background="#FFE0A83A"
                    VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                           Foreground="#FF17181D" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,10,0">
                <TextBlock Text="BOSS-TIMER" FontSize="11" FontWeight="Bold"
                           Foreground="#FFE0B75B" />
                <TextBlock x:Name="BossName" FontSize="19" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                <TextBlock x:Name="Countdown" FontSize="13" Foreground="#FFE5E6E8"
                           TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="Klicke zum Öffnen der Boss-Timer" FontSize="10.5"
                           Foreground="#FF9FA5AD" Margin="0,7,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Click="Close_Click" Width="24" Height="24"
                    Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                    Foreground="#FFB7BBC2" Background="Transparent" BorderThickness="0"
                    Padding="0" VerticalAlignment="Top" />
        </Grid>
    </Border>
</Window>
