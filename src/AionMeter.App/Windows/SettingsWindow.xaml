<Window x:Class="AionMeter.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding SettingsTitle, Source={x:Static s:UiText.Current}}" Width="785" Height="700" MinWidth="760" MinHeight="580"
        WindowStyle="None" WindowStartupLocation="Manual" ResizeMode="CanResize" Background="{StaticResource Bg0}" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#171518" />
            <Setter Property="BorderBrush" Value="#393337" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="OverlayCard" TargetType="Border">
            <Setter Property="Background" Value="#121216" />
            <Setter Property="BorderBrush" Value="#393337" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="24,0,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="190" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,1,0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Gold}" Visibility="Collapsed" Margin="-7,1,0,1" />
                                <ContentPresenter VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverFill}" />
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayModeButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Background" Value="#201B1B" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#30201A" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A55023" />
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#78391F" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Bg2}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Width" Value="140" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.ColumnSpan="2" Grid.RowSpan="3" Margin="20,8,8,0" VerticalAlignment="Top" Height="36">
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Save_Click" ToolTip="Einstellungen übernehmen und schließen" HorizontalAlignment="Right"
                        VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <StackPanel Margin="16,24,14,16">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,28">
                        <Border Width="34" Height="34" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Image Source="pack://application:,,,/Assets/aetherion-mark.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="AETHERION" Foreground="{StaticResource Text}" FontWeight="Bold" FontSize="12" />
                            <TextBlock Text="CONTROL CENTER" Foreground="{StaticResource TextMute}" FontSize="8.5" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="METER" Foreground="{StaticResource TextMute}" FontSize="9" FontWeight="Bold" Margin="12,0,0,7" />
                    <Button x:Name="NavOverlayButton" Style="{StaticResource SettingsNavButton}" Content="{Binding NavOverlay, Source={x:Static s:UiText.Current}}" Tag="overlay" Click="SettingsNav_Click" />
                    <Button Style="{StaticResource SettingsNavButton}" Content="{Binding NavTimer, Source={x:Static s:UiText.Current}}" Tag="timer" Click="SettingsNav_Click" />
                    <Button Style="{StaticResource SettingsNavButton}" Content="{Binding NavFights, Source={x:Static s:UiText.Current}}" Tag="fights" Click="SettingsNav_Click" />
                    <Button Style="{StaticResource SettingsNavButton}" Content="{Binding NavAppearance, Source={x:Static s:UiText.Current}}" Tag="appearance" Click="SettingsNav_Click" />
                    <Button Style="{StaticResource SettingsNavButton}" Content="{Binding NavGeneral, Source={x:Static s:UiText.Current}}" Tag="general" Click="SettingsNav_Click" />
                    <TextBlock Text="AION2 EXTRAS" Foreground="{StaticResource TextMute}" FontSize="9" FontWeight="Bold" Margin="12,18,0,7" />
                    <Button Style="{StaticResource SettingsNavButton}" Content="{Binding NavPvp, Source={x:Static s:UiText.Current}}" Tag="pvp" Click="SettingsNav_Click" />
                    <Button Style="{StaticResource SettingsNavButton}" Content="{Binding NavMap, Source={x:Static s:UiText.Current}}" Tag="map" Click="SettingsNav_Click" />
                    <Button Style="{StaticResource SettingsNavButton}" Content="{Binding NavGuide, Source={x:Static s:UiText.Current}}" Tag="guide" Click="SettingsNav_Click" />
                    <TextBlock Text="KONTO" Foreground="{StaticResource TextMute}" FontSize="9" FontWeight="Bold" Margin="12,18,0,7" />
                    <Button Style="{StaticResource SettingsNavButton}" Content="{Binding NavAccount, Source={x:Static s:UiText.Current}}" Tag="account" Click="SettingsNav_Click" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,0">
                <StackPanel>
                    <StackPanel Margin="0,20,0,24">
                        <TextBlock Text="{Binding SettingsKicker, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" FontWeight="Bold" FontSize="10" Margin="0,0,0,8" />
                        <TextBlock x:Name="PageTitle" Text="Overlay anpassen" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle" Text="{Binding SettingsPageHint, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border x:Name="PremiumSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="AETHERION • PREMIUM" Foreground="{StaticResource Gold}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="Farm-Routen für Kinah und Pets direkt im Meter." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Farm-Guide öffnen" Click="FarmGuide_Click" HorizontalAlignment="Left" />
                                <Button Style="{StaticResource GhostButton}" Content="Discord Support" Click="DiscordSupport_Click"
                                        HorizontalAlignment="Left" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Language -->
                    <Border x:Name="LanguageSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding SecLanguage, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LanguageLabel, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <ComboBox x:Name="LanguageBox" MinWidth="190" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="{Binding LanguageHint, Source={x:Static s:UiText.Current}}" />
                        </StackPanel>
                    </Border>

                    <!-- Overlay -->
                    <StackPanel x:Name="OverlaySection">
                        <Button Content="Komfort &amp; Analyse öffnen" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12" Click="CustomerTools_Click" />
                        <TextBlock Text="{Binding CombatOverlayLabel, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource Gold}" FontWeight="Bold" FontSize="10" Margin="0,0,0,9" />
                        <Border Style="{StaticResource OverlayCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding OverlayViewTitle, Source={x:Static s:UiText.Current}}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="Wähle, was im Kampf im Vordergrund steht." />
                                <UniformGrid Columns="2">
                                    <ToggleButton x:Name="CombinedView" Style="{StaticResource OverlayModeButton}" Content="{Binding CombinedOverlayMode, Source={x:Static s:UiText.Current}}" Tag="combined" Click="OverlayView_Click" />
                                    <ToggleButton x:Name="CompactView" Style="{StaticResource OverlayModeButton}" Content="{Binding CompactOverlayMode, Source={x:Static s:UiText.Current}}" Tag="compact" Click="OverlayView_Click" Margin="0" />
                                </UniformGrid>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,14" />
                                <TextBlock Text="{Binding VisibleInfoTitle, Source={x:Static s:UiText.Current}}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" Text="Zusatzwerte bleiben dezent und optional." />
                                <UniformGrid Columns="2">
                                    <CheckBox x:Name="ShowBoss" Style="{StaticResource DarkCheck}" Content="{Binding ShowBossHpInfo, Source={x:Static s:UiText.Current}}" />
                                    <CheckBox x:Name="ShowPeakDps" Style="{StaticResource DarkCheck}" Content="{Binding ShowPeakDpsInfo, Source={x:Static s:UiText.Current}}" />
                                    <CheckBox x:Name="ShowHealingPanel" Style="{StaticResource DarkCheck}" Content="{Binding ShowHealingInfo, Source={x:Static s:UiText.Current}}" />
                                    <CheckBox x:Name="ShowGear" Style="{StaticResource DarkCheck}" Content="{Binding ShowGearInfo, Source={x:Static s:UiText.Current}}" />
                                </UniformGrid>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,14" />
                                <TextBlock Text="{Binding WindowSizeTitle, Source={x:Static s:UiText.Current}}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="{Binding WindowSizeHint, Source={x:Static s:UiText.Current}}" />
                                <UniformGrid Columns="3">
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding PresetCompact, Source={x:Static s:UiText.Current}}" Tag="compact" Click="SizePreset_Click" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding PresetStandard, Source={x:Static s:UiText.Current}}" Tag="standard" Click="SizePreset_Click" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding PresetLarge, Source={x:Static s:UiText.Current}}" Tag="large" Click="SizePreset_Click" />
                                </UniformGrid>
                                <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,14" />
                                <TextBlock Text="{Binding TransparencyTitle, Source={x:Static s:UiText.Current}}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="{Binding TransparencyHint, Source={x:Static s:UiText.Current}}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TransparentLabel, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Slider x:Name="OpacityValue" Style="{StaticResource GoldSlider}" Width="300" Minimum="0" Maximum="1" />
                                    <TextBlock Text="{Binding OpaqueLabel, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border x:Name="MapSection" Style="{StaticResource Section}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="QUESTLOG.GG · AION2" Foreground="{StaticResource Gold}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding MapPageTitle, Source={x:Static s:UiText.Current}}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MapPageHint, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" Margin="0,6,0,12" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding OpenMapLabel, Source={x:Static s:UiText.Current}}" Click="OpenMap_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="GuideSection" Style="{StaticResource Section}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="AION2 GUIDE · SEPARATES FENSTER" Foreground="{StaticResource Gold}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding GuidePageTitle, Source={x:Static s:UiText.Current}}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GuidePageHint, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" Margin="0,6,0,12" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding OpenGuideLabel, Source={x:Static s:UiText.Current}}" Click="OpenGuide_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="PvpSection" Style="{StaticResource Section}" Visibility="Collapsed">
                        <StackPanel>
                            <Border Background="#171518" BorderBrush="#503825" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="AETHERION · PVP" Foreground="{StaticResource Gold}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            <Border Background="#2AF06A22" BorderBrush="#80F06A22" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding PvpPreview, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource GoldBright}" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PvpPageTitle, Source={x:Static s:UiText.Current}}" FontSize="21" FontWeight="Bold" />
                                        <TextBlock Text="{Binding PvpLockedHint, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" TextWrapping="Wrap" Margin="0,7,0,0" MaxWidth="500" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="76" Height="76" CornerRadius="16" Background="#241B18" BorderBrush="#754322" BorderThickness="1" VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="27" Foreground="{StaticResource GoldBright}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding PvpComingSoon, Source={x:Static s:UiText.Current}}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextDim}" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding PvpComingSoon, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="2,0,0,8" />
                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="14,13" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PvpPointsTitle, Source={x:Static s:UiText.Current}}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PvpPointsHint, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" FontSize="11" Margin="0,5,0,12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PvpComingSoon, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource GoldBright}" FontSize="9" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="14,13" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PvpRankTitle, Source={x:Static s:UiText.Current}}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PvpRankHint, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" FontSize="11" Margin="0,5,0,12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PvpComingSoon, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource GoldBright}" FontSize="9" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="14,13">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PvpLadderTitle, Source={x:Static s:UiText.Current}}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PvpLadderHint, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" FontSize="11" Margin="0,5,0,12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PvpComingSoon, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource GoldBright}" FontSize="9" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Background="#111114" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="13,11">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Gold}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PvpPageHint, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AppearanceSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding NavAppearance, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <CheckBox x:Name="BarsRelative" Style="{StaticResource DarkCheck}" Content="{Binding BarsRelative, Source={x:Static s:UiText.Current}}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding BarsRelativeHint, Source={x:Static s:UiText.Current}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding RowsShown, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <ComboBox x:Name="MaxRows" MinWidth="80" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding RowSize, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <Slider x:Name="RowSizeValue" Style="{StaticResource GoldSlider}" Width="180" Minimum="50" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="RowSize_Changed" />
                                <TextBlock x:Name="RowSizeText" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="190,2,0,0" Text="{Binding RowSizeHint, Source={x:Static s:UiText.Current}}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="OverlayBehaviorSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding NavGeneral, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <CheckBox x:Name="AutoShow" Style="{StaticResource DarkCheck}" Content="{Binding AutoShow, Source={x:Static s:UiText.Current}}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding AutoShowHint, Source={x:Static s:UiText.Current}}" />
                            <CheckBox x:Name="ShowOnStart" Style="{StaticResource DarkCheck}" Content="{Binding ShowOnStart, Source={x:Static s:UiText.Current}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding AutoHide, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" Width="260" />
                                <TextBox x:Name="AutoHideSeconds" Width="70" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TimerSection" Style="{StaticResource Section}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{Binding NavTimer, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimerAlertLabel, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" Width="280" />
                                <TextBox x:Name="BossAlertMinutesBox" Width="70" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding TimerOpacityLabel, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" Width="280" />
                                <Slider x:Name="EventTimerOpacity" Style="{StaticResource GoldSlider}" Width="220" Minimum="0" Maximum="1" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Timer-Fenster und Boss-Hinweise werden gemeinsam gespeichert." />
                        </StackPanel>
                    </Border>

                    <!-- Discord Rich Presence -->
                    <Border x:Name="MeterSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding DiscordPresenceSection, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <CheckBox x:Name="DiscordPresence" Style="{StaticResource DarkCheck}"
                                      Content="{Binding DiscordPresenceEnabled, Source={x:Static s:UiText.Current}}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding DiscordPresenceHint, Source={x:Static s:UiText.Current}}" />
                        </StackPanel>
                    </Border>

                    <!-- Meter -->
                    <Border x:Name="HistorySection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding SecMeter, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Measure, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <ComboBox x:Name="Mode">
                                    <ComboBoxItem Content="{Binding MeasureBoss, Source={x:Static s:UiText.Current}}" />
                                    <ComboBoxItem Content="{Binding MeasureAll, Source={x:Static s:UiText.Current}}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding IdleEnd, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <TextBox x:Name="Idle" Width="60" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding IdleBoss, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <TextBox x:Name="BossIdle" Width="60" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- History -->
                    <Border x:Name="CaptureSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding SecHistory, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <CheckBox x:Name="SaveHistory" Style="{StaticResource DarkCheck}"
                                      Content="{Binding SaveAuto, Source={x:Static s:UiText.Current}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding WhichFights, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <ComboBox x:Name="HistoryModeBox" MinWidth="250">
                                    <ComboBoxItem Content="{Binding HistBosses, Source={x:Static s:UiText.Current}}" />
                                    <ComboBoxItem Content="{Binding HistBossesLong, Source={x:Static s:UiText.Current}}" />
                                    <ComboBoxItem Content="{Binding HistAll, Source={x:Static s:UiText.Current}}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding LongerThan, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <TextBox x:Name="HistoryMin" Width="60" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding HistoryHint, Source={x:Static s:UiText.Current}}" />
                            <TextBlock x:Name="HistoryInfo" Style="{StaticResource Hint}" Margin="0,2,0,0" Foreground="{StaticResource TextDim}" />
                        </StackPanel>
                    </Border>

                    <!-- Capture -->
                    <Border x:Name="HotkeysSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding SecCapture, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NetworkAdapter, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <ComboBox x:Name="Device" MinWidth="300" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,6" Text="{Binding AdapterHint, Source={x:Static s:UiText.Current}}" />
                            <CheckBox x:Name="Record" Style="{StaticResource DarkCheck}"
                                      Content="{Binding RecordPackets, Source={x:Static s:UiText.Current}}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding RecordHint, Source={x:Static s:UiText.Current}}" />
                            <TextBlock x:Name="CaptureState" Style="{StaticResource Hint}" Margin="0,6,0,0" Foreground="{StaticResource TextDim}" />
                            <Border Margin="0,10,0,0" Padding="10,8" Background="#101216" BorderBrush="#393337" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding ConnectionCheckTitle, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource Gold}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding RunConnectionCheck, Source={x:Static s:UiText.Current}}" Click="RefreshDiagnostics_Click" Padding="9,4" />
                                    </DockPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding DiagnosticGame, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" Margin="0,2,8,2" />
                                        <TextBlock x:Name="GameCheckValue" Grid.Row="0" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,2,0,2" />
                                        <TextBlock Grid.Row="1" Text="{Binding DiagnosticNpcap, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" Margin="0,2,8,2" />
                                        <TextBlock x:Name="NpcapCheckValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,2,0,2" />
                                        <TextBlock Grid.Row="2" Text="{Binding DiagnosticCapture, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" Margin="0,2,8,2" />
                                        <TextBlock x:Name="CaptureCheckValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,2,0,2" />
                                        <TextBlock Grid.Row="3" Text="{Binding DiagnosticPackets, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" Margin="0,2,8,2" />
                                        <TextBlock x:Name="PacketsCheckValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,2,0,2" />
                                        <TextBlock Grid.Row="4" Text="{Binding DiagnosticDecoded, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" Margin="0,2,8,2" />
                                        <TextBlock x:Name="DecodedCheckValue" Grid.Row="4" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,2,0,2" />
                                        <TextBlock Grid.Row="5" Text="{Binding DiagnosticOverlay, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" Margin="0,2,8,2" />
                                        <TextBlock x:Name="OverlayCheckValue" Grid.Row="5" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,2,0,2" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="{Binding CopySupportReport, Source={x:Static s:UiText.Current}}" Click="CopyDiagnosticReport_Click" Padding="9,4" />
                                        <TextBlock x:Name="DiagnosticFeedback" Foreground="{StaticResource TextDim}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConnectionCheckHint, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Hotkeys -->
                    <Border x:Name="LicenseSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding SecHotkeys, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding HkToggle, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <TextBox x:Name="HkToggle" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding HkReset, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <TextBox x:Name="HkReset" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding HkClick, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <TextBox x:Name="HkClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding HkTimers, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                                <TextBox x:Name="HkTimers" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding HotkeysHint, Source={x:Static s:UiText.Current}}" />
                        </StackPanel>
                    </Border>

                    <!-- Updates -->
                    <!-- Aetherion account and license -->
                    <Border x:Name="UpdatesSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="AETHERION • LIZENZ" Foreground="{StaticResource Gold}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock x:Name="LicenseStatusText" Text="Lizenzstatus wird geladen …" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="LicenseKeyBox" Width="230" ToolTip="AETH-…" />
                                <Button x:Name="RedeemLicenseButton" Style="{StaticResource GhostButton}" Content="Key einlösen" Click="RedeemLicense_Click" Margin="8,0,8,0" />
                                <Button Style="{StaticResource GhostButton}" Content="Abmelden" Click="Logout_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Keys erhältst du nach dem Kauf über ein Discord-Ticket. Verlängerungs-Keys werden zur Restlaufzeit addiert." />
                        </StackPanel>
                    </Border>

                    <!-- Updates -->
                    <Border x:Name="DataSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding SecUpdates, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <CheckBox x:Name="CheckUpdates" Style="{StaticResource DarkCheck}"
                                      Content="{Binding CheckUpdatesAuto, Source={x:Static s:UiText.Current}}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Updates werden direkt im Meter geladen. Installierte Versionen installieren sie automatisch in einem ruhigen Moment; portable Kopien aktualisieren sich über das Update-Fenster." />
                            <CheckBox x:Name="AutoInstallUpdates" Style="{StaticResource DarkCheck}" Margin="0,4,0,0"
                                      Content="{Binding AutoInstallUpdates, Source={x:Static s:UiText.Current}}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding AutoInstallHint, Source={x:Static s:UiText.Current}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,14,0" />
                                <Button x:Name="CheckNowButton" Style="{StaticResource GhostButton}" Click="CheckNow_Click"
                                        Content="{Binding CheckNow, Source={x:Static s:UiText.Current}}" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateState" Style="{StaticResource Hint}" Margin="0,6,0,0" Foreground="{StaticResource TextDim}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Data -->
                    <Border x:Name="DataFilesSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding SecData, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <CheckBox x:Name="Icons" Style="{StaticResource DarkCheck}"
                                      Content="{Binding DownloadIcons, Source={x:Static s:UiText.Current}}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding IconsHint, Source={x:Static s:UiText.Current}}" />
                            <TextBlock x:Name="DataInfo" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="{Binding OpenDataFolder, Source={x:Static s:UiText.Current}}"
                                        Click="OpenData_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostButton}" Content="{Binding OpenAppFolder, Source={x:Static s:UiText.Current}}"
                                        Click="OpenAppData_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostButton}" Content="{Binding Logs, Source={x:Static s:UiText.Current}}"
                                        Click="OpenLogs_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="DisclaimerText" Style="{StaticResource Hint}" Margin="4,0,4,16" Text="{Binding Disclaimer, Source={x:Static s:UiText.Current}}" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="{Binding Cancel, Source={x:Static s:UiText.Current}}"
                            Click="Cancel_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding Save, Source={x:Static s:UiText.Current}}"
                            Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
