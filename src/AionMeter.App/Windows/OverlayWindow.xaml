<Window x:Class="AionMeter.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:vm="clr-namespace:AionMeter.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="Root"
        Title="AION2 DPS Meter" Width="470" Height="540" MinWidth="300" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" SizeChanged="Overlay_SizeChanged"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <c:VisibleIf x:Key="VisibleIf" />

        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
        </Storyboard>

        <!-- Row size (Settings → Overlay → Row size, Ctrl + wheel over the rows): OverlayWindow.ApplyRowSize replaces
             these. The value columns are as wide as their widest value (shared size groups across the rows), so the name
             gets all the room that is left. -->
        <GridLength x:Key="ColRankWidth">20</GridLength>
        <GridLength x:Key="ColGlyphWidth">26</GridLength>
        <Thickness x:Key="ColGap">10,0,0,0</Thickness>
        <sys:Double x:Key="NameMaxWidth">220</sys:Double>
        <sys:Double x:Key="RowHeight">28</sys:Double>
        <Thickness x:Key="RowMargin">0,0,0,3</Thickness>
        <sys:Double x:Key="RowNameFont">13.5</sys:Double>
        <sys:Double x:Key="RowGearFont">12</sys:Double>
        <sys:Double x:Key="RowNumberFont">13.5</sys:Double>
        <sys:Double x:Key="RowSubFont">12</sys:Double>
        <sys:Double x:Key="RowGlyphSize">20</sys:Double>
        <sys:Double x:Key="RowRankFont">11</sys:Double>
        <sys:Double x:Key="RowAccentWidth">3</sys:Double>

        <!-- A soft dark halo under every text so it stays readable over any game scene -->
        <DropShadowEffect x:Key="TextShadow" BlurRadius="4" ShadowDepth="1" Direction="300" Opacity="0.9" Color="Black" />

        <!-- DPS: the figure that matters, white and a little bolder -->
        <Style x:Key="RowNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowNumberFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="{DynamicResource ColGap}" />
        </Style>

        <!-- Total damage and share: smaller and softer than the DPS -->
        <Style x:Key="RowSub" TargetType="TextBlock" BasedOn="{StaticResource RowNumber}">
            <Setter Property="FontSize" Value="{DynamicResource RowSubFont}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#C4CBD8" />
        </Style>

        <!-- Gear score and combat power: "GS 2822  CP 50.5K" — a light label and a bold coloured value, one size and one
             baseline, no box (a box crowds a slim row); the row's text shadow keeps them readable on any class colour -->
        <Style x:Key="GearText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowGearFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,1" />
        </Style>

        <!-- The hover toolbar's buttons: clear, high-contrast icon chips that stay legible over the game. -->
        <Style x:Key="ToolIcon" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <SolidColorBrush x:Key="Cream" Color="#F3E6C8" />
        <SolidColorBrush x:Key="Soft" Color="#C3CAD8" />
        <SolidColorBrush x:Key="SelfGold" Color="#FF9B4A" />

        <!-- A hairline frame, a touch lighter at the top -->
        <LinearGradientBrush x:Key="CardFrame" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0" />
            <GradientStop Color="#1AFFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HpFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#B9303A" Offset="0" />
            <GradientStop Color="#EE5A5E" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="FooterLink" TargetType="Button">
            <Setter Property="Foreground" Value="#FF9B4A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="P" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFB56D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterAction" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD4D7" />
            <Setter Property="Background" Value="#19252D" />
            <Setter Property="BorderBrush" Value="#30414A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#26343B" />
                                <Setter Property="Foreground" Value="#FFB56D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The footer's boss timer button: a quiet outlined pill, still plainly a button -->
        <Style x:Key="TimersPill" TargetType="Button">
            <Setter Property="Foreground" Value="#FF9B4A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Padding="8,2,9,2" BorderThickness="1" BorderBrush="#66FF741F" Background="#1AFF741F">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF741F" />
                                <Setter TargetName="Bd" Property="Background" Value="#33FF741F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "A new version is out": a slim green banner above the footer, only while an update is available -->
        <Style x:Key="UpdateBannerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D2FAE6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="9,3,9,3" BorderThickness="1" BorderBrush="#803DD68C" Background="#2A3DD68C">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3DD68C" />
                                <Setter TargetName="Bd" Property="Background" Value="#403DD68C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One player: a slim bar in the class colour fading out towards its tip, a strip of that colour at the left edge,
             the place, emblem, name with gear score and combat power, then DPS, total damage and share -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:RowViewModel}">
            <Grid Height="{DynamicResource RowHeight}" Margin="{DynamicResource RowMargin}" Cursor="Hand" ToolTip="{Binding Tooltip}"
                  Background="Transparent" MouseLeftButtonUp="Row_Click" MouseRightButtonUp="Row_RightClick">
                <!-- track -->
                <Border x:Name="Track" CornerRadius="4" Background="#B20B1119" />
                <!-- fill -->
                <Border CornerRadius="4" Background="{Binding SoftFillBrush}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Fill}" />
                    </Border.RenderTransform>
                </Border>
                <!-- class strip -->
                <Border Width="{DynamicResource RowAccentWidth}" HorizontalAlignment="Left" CornerRadius="4,0,0,4" Background="{Binding AccentBrush}" />
                <!-- your own row -->
                <Border CornerRadius="4" BorderThickness="1" BorderBrush="#B3FF9B4A"
                        Visibility="{Binding IsSelf, Converter={StaticResource VisibleIf}}" />

                <Grid Margin="8,0,10,0" Effect="{StaticResource TextShadow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource ColRankWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColGlyphWidth}" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Gs" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Cp" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Dps" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Damage" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Share" />
                    </Grid.ColumnDefinitions>

                    <!-- Place: plain digits, the top three in medal colours -->
                    <TextBlock Text="{Binding RankText}" FontFamily="{StaticResource NumberFont}" FontSize="{DynamicResource RowRankFont}"
                               FontWeight="Bold" Foreground="{Binding RankColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <c:ClassGlyph Grid.Column="1" Class="{Binding Class}" OnBar="True" Width="{DynamicResource RowGlyphSize}"
                                  Height="{DynamicResource RowGlyphSize}" HorizontalAlignment="Left" />

                    <!-- As wide as the longest name, up to what the other columns leave (OverlayWindow.FitNames) -->
                    <TextBlock x:Name="NameText" Grid.Column="2" Text="{Binding Name}" FontSize="{DynamicResource RowNameFont}" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,0,1"
                               MaxWidth="{DynamicResource NameMaxWidth}" />

                    <!-- Gear score and combat power, right by the name: only players of your party have them (the party roster) -->
                    <TextBlock Grid.Column="3" Style="{StaticResource GearText}" Visibility="{Binding HasGearScore, Converter={StaticResource VisibleIf}}"
                               ToolTip="{Binding DataContext.T.TipGs, RelativeSource={RelativeSource AncestorType=Window}}"><Run Text="GS " FontWeight="SemiBold" Foreground="#D5DAE4" /><Run Text="{Binding GearScore, Mode=OneWay}" Foreground="#FFB56D" /></TextBlock>
                    <TextBlock Grid.Column="4" Style="{StaticResource GearText}" Visibility="{Binding HasCombatPower, Converter={StaticResource VisibleIf}}"
                               ToolTip="{Binding DataContext.T.TipCp, RelativeSource={RelativeSource AncestorType=Window}}"><Run Text="CP " FontWeight="SemiBold" Foreground="#D5DAE4" /><Run Text="{Binding CombatPower, Mode=OneWay}" Foreground="#FFD0A8" /></TextBlock>

                    <TextBlock Grid.Column="6" Text="{Binding Dps}" Style="{StaticResource RowNumber}"
                               ToolTip="{Binding DataContext.T.TipDps, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Grid.Column="7" Text="{Binding Damage}" Style="{StaticResource RowSub}"
                               ToolTip="{Binding DataContext.T.TipDamage, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Grid.Column="8" Text="{Binding Share}" Style="{StaticResource RowSub}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="#D20B1119" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource SelfGold}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Border x:Name="Frame" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource CardFrame}">
            <Border.Background>
                <SolidColorBrush x:Name="FrameBackground" Color="#0A0B0D" Opacity="0.92" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <!-- Aetherion signature line: a small orange sweep anchors the card without cluttering the fight data. -->
        <Border x:Name="SignatureLine" Height="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF741F" Offset="0" />
                    <GradientStop Color="#FFB56D" Offset="0.48" />
                    <GradientStop Color="#FF741F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="CardBody" Margin="12,8,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The one top line: the fight's title on the left (the toolbar while the mouse is over the overlay), the state
                 and the timer on the right -->
            <Grid x:Name="Header" Background="Transparent" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                    <StackPanel x:Name="FightTitlePanel" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                        <Border Background="#FF741F" CornerRadius="1" Width="3" Height="10" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding T.OverlayLive}" FontSize="8" FontWeight="Bold" Foreground="#FFB56D" />
                    </StackPanel>
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#EEF0F5" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,1,10,0" Effect="{StaticResource TextShadow}" Background="Transparent"
                           MouseWheel="Title_MouseWheel" ToolTip="{Binding TitleTip}" />
                    </StackPanel>

                <StackPanel x:Name="Toolbar" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Button Style="{StaticResource Chip}" Content="{Binding ModeLabel}" Click="Mode_Click" Margin="0,0,5,0"
                            ToolTip="{Binding T.TipTargetMode}" />
                    <Button Style="{StaticResource Chip}" Content="{Binding RankingLabel}" Click="Ranking_Click" Margin="0,0,5,0"
                            ToolTip="Switch DPS / HPS ranking" />
                    <Button Style="{StaticResource Chip}" Content="{Binding LanguageCode}" Click="Language_Click" Margin="0,0,5,0"
                            ToolTip="{Binding T.SwitchLanguage}" />
                    <Button x:Name="ChatToolButton" Style="{StaticResource ToolIcon}" Content="&#xE8BD;" Click="Chat_Click" ToolTip="{Binding T.TipChat}" />
                    <Button x:Name="MapToolButton" Style="{StaticResource ToolIcon}" Content="&#xE774;" Click="Map_Click" ToolTip="{Binding T.MapLabel}" />
                    <Button x:Name="GuideToolButton" Style="{StaticResource ToolIcon}" Content="&#xE8A7;" Click="Wakayashi_Click" ToolTip="Wakayashi.gg in eigenem Fenster öffnen" />
                    <Button x:Name="TimersToolButton" Style="{StaticResource ToolIcon}" Content="&#xE121;" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" />
                    <Button x:Name="EventsToolButton" Style="{StaticResource ToolIcon}" Content="&#xE787;" Click="Events_Click" ToolTip="{Binding T.EventTimersTitle}" />
                    <Button x:Name="RestartButton" Style="{StaticResource ToolIcon}" Content="&#xE72C;" Click="Restart_Click" />
                    <ToggleButton x:Name="LockButton" Style="{StaticResource ToolToggle}" Click="Lock_Click" ToolTip="{Binding T.TipLock}">
                        <TextBlock x:Name="LockGlyph" Text="&#xE785;" />
                    </ToggleButton>
                    <Button x:Name="SettingsToolButton" Style="{StaticResource ToolIcon}" Content="&#xE713;" Click="Settings_Click" ToolTip="{Binding T.TipSettings}" />
                    <Slider x:Name="OpacitySlider" Style="{StaticResource GoldSlider}" Width="52" Minimum="0.15" Maximum="1" Margin="5,0,3,0"
                            ValueChanged="Opacity_Changed" VerticalAlignment="Center" ToolTip="{Binding T.TipOpacity}" />
                    <Button x:Name="HideToolButton" Style="{StaticResource ToolIcon}" Content="&#xE711;" Click="Hide_Click" ToolTip="{Binding T.TipHide}" />
                </StackPanel>

                <Border Grid.Column="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Effect="{StaticResource TextShadow}">
                    <TextBlock x:Name="PartnerBadge" Text="✦ PARTNER" Visibility="Collapsed" Foreground="{StaticResource Gold}"
                               FontWeight="Bold" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <!-- The game's time limit for this instance: stays in view while the toolbar shows, like the clock -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Background="Transparent"
                                ToolTip="{Binding LimitTip}" Visibility="{Binding HasLimit, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{Binding LimitBrush}"
                                   Margin="0,1,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LimitText}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{Binding LimitBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="LabelPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding HeaderBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PulseBegin" Storyboard="{StaticResource Pulse}" />
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PulseBegin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding HeaderLabel}" Foreground="#B5C0CC" FontSize="9" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource NumberFont}" FontWeight="Bold" FontSize="13.5"
                               Foreground="#FF9B4A" VerticalAlignment="Center" />
                </StackPanel>
                </Border>
            </Grid>

            <!-- Encounter identity and boss health, in one compact tactical strip -->
            <Grid Grid.Row="1" Height="20" Margin="0,5,0,0" Visibility="{Binding HasBoss, Converter={StaticResource VisibleIf}}">
                <Border CornerRadius="5" Background="#D00B1118" BorderBrush="#52616D" BorderThickness="1" />
                <Grid x:Name="BossHealthTrack" Margin="1" ClipToBounds="True">
                    <Border CornerRadius="4" Background="#70434A52" />
                    <Border Height="7" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Margin="0,0,0,0" Background="{StaticResource HpFill}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding BossHpFraction}" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <Grid Margin="9,0">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.9" Color="Black" />
                    </Grid.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Visibility="Collapsed" Text="{Binding T.ShowBossHpInfo}" FontSize="8" FontWeight="Bold" Foreground="#FFB56D" />
                        <TextBlock Text="{Binding BossHpText}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="10"
                                   Foreground="#CBD4D4" />
                    </StackPanel>
                    <TextBlock Text="{Binding BossPercent}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="10.5"
                               Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- Group output at a glance -->
            <Grid Grid.Row="2" Height="0" Margin="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border x:Name="GroupDpsCard" Background="#141618" BorderBrush="#30271F" BorderThickness="1" CornerRadius="8" Padding="10,7">
                    <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#FF741F" Width="3" Height="9" Margin="0,0,6,0" /><TextBlock Text="{Binding T.GroupDps}" FontSize="8" FontWeight="Bold" Foreground="#B7B1AA" /></StackPanel>
                        <TextBlock Text="{Binding PartyDps}" FontFamily="{StaticResource NumberFont}" FontSize="22" FontWeight="ExtraBold" Foreground="#F4F0EB" />
                    </StackPanel>
                </Border>
                <Border x:Name="GroupHpsCard" Grid.Column="2" Background="#10211F" BorderBrush="#1B5049" BorderThickness="1" CornerRadius="8" Padding="10,7">
                    <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#43D7B4" Width="3" Height="9" Margin="0,0,6,0" /><TextBlock Text="{Binding T.GroupHps}" FontSize="8" FontWeight="Bold" Foreground="#76CDBA" /></StackPanel>
                        <TextBlock Text="{Binding PartyHps}" FontFamily="{StaticResource NumberFont}" FontSize="22" FontWeight="ExtraBold" Foreground="#E5F8F1" /></StackPanel>
                </Border>
            </Grid>

            <!-- Party: the rows share their value column widths -->
            <Grid Grid.Row="3" Margin="0,7,0,0" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- No column labels (the numbers read by themselves: 738K/s, 14.58M, 22.5 %): this empty grid only tells
                     OverlayWindow.FitNames how wide the rows' columns are -->
                <Grid x:Name="ColumnLabels" Height="0" Margin="10,0,12,0">
                    <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="28" />
                     <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <Grid Grid.Row="0" Margin="0,0,10,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="RANG · SPIELER" FontSize="8" FontWeight="Bold" Foreground="#899BA5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="DPS" FontSize="8" FontWeight="Bold" Foreground="#758B94" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="4" Text="{Binding T.OverlayShare}" FontSize="8" FontWeight="Bold" Foreground="#758B94" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Padding="8,0,7,0" Margin="-8,0,-7,0" PreviewMouseWheel="Rows_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                </ScrollViewer>
                <TextBlock Grid.RowSpan="2" Text="{Binding T.EmptyParty}" FontSize="12"
                           Foreground="#807971" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding HasData, Converter={StaticResource VisibleIf}, ConverterParameter=!}" />
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <!-- New version on GitHub: a slim banner until it is installed, skipped or closed for this session -->
                <Grid x:Name="UpdateBanner" Margin="0,0,0,6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource UpdateBannerButton}" Click="Update_Click" ToolTip="{Binding T.TipUpdate}">
                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Click="UpdateBannerClose_Click" Margin="4,0,8,0"
                            VerticalAlignment="Center" ToolTip="{Binding T.UpdateLater}" />
                </Grid>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="FooterStatus" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Status}">
                        <TextBlock x:Name="FooterText" FontSize="11" Foreground="#A9B1C0" TextTrimming="CharacterEllipsis"
                                   Effect="{StaticResource TextShadow}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,35,0">
                        <Ellipse Width="5" Height="5" Fill="#45C2B0" Margin="0,0,5,0" />
                        <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#A9B9BC" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FooterDetailsButton" Style="{StaticResource FooterAction}" Content="{Binding T.FooterDetailsLabel}" Click="Details_Click" />
                    <Button x:Name="FooterCompareButton" Style="{StaticResource FooterAction}" Content="{Binding T.FooterCompareLabel}" Click="Compare_Click" />
                    <Button x:Name="FooterSettingsButton" Style="{StaticResource ToolIcon}" Content="&#xE713;" Click="Settings_Click"
                            ToolTip="{Binding T.TipSettings}" AutomationProperties.Name="Einstellungen" />
                    <Button x:Name="FooterRankingButton" Style="{StaticResource FooterAction}" Content="{Binding T.FooterRankingLabel}" Click="Ranking_Click"
                            Background="#261A12" BorderBrush="#82421C" Foreground="#FF9B4A" Margin="0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Resize grip -->
        <Thumb x:Name="ResizeGrip" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
               Cursor="SizeNWSE" ToolTip="Fenstergröße ändern · am Eck ziehen" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="GripBack" Background="#D90A0B0D" BorderBrush="#75FF741F" BorderThickness="1" CornerRadius="8">
                    <Path Data="M23 5 L5 23 M23 13 L13 23" Stroke="#FFFF9B4A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <!-- Separate edge handles let users change the width or height without also changing the other dimension. -->
        <Thumb x:Name="ResizeWidthGrip" Width="8" Height="72" HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="0,0,1,0" Cursor="SizeWE" Tag="width" ToolTip="Breite ändern" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb x:Name="ResizeHeightGrip" Width="72" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom"
               Margin="0,0,0,1" Cursor="SizeNS" Tag="height" ToolTip="Höhe ändern" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    </Grid>
</Window>
