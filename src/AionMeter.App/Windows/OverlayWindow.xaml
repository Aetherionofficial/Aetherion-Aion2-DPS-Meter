<Window x:Class="AionMeter.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:vm="clr-namespace:AionMeter.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="Root"
        Title="AION2 DPS Meter" Width="600" Height="300" MinWidth="300" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" SizeChanged="Overlay_SizeChanged"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <c:VisibleIf x:Key="VisibleIf" />
        <c:OverlayDisplayConverter x:Key="OverlayDisplay" />

        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
        </Storyboard>

        <!-- Row size (Settings → Overlay → Row size, Ctrl + wheel over the rows): OverlayWindow.ApplyRowSize replaces
             these. The value columns are as wide as their widest value (shared size groups across the rows), so the name
             gets all the room that is left. -->
        <GridLength x:Key="ColRankWidth">20</GridLength>
        <GridLength x:Key="ColGlyphWidth">26</GridLength>
        <Thickness x:Key="ColGap">10,0,0,0</Thickness>
        <sys:Double x:Key="NameMaxWidth">220</sys:Double>
        <sys:Double x:Key="RowHeight">42</sys:Double>
        <Thickness x:Key="RowMargin">0,0,0,2</Thickness>
        <sys:Double x:Key="RowNameFont">15</sys:Double>
        <sys:Double x:Key="RowGearFont">11.5</sys:Double>
        <sys:Double x:Key="RowNumberFont">14</sys:Double>
        <sys:Double x:Key="RowSubFont">11</sys:Double>
        <sys:Double x:Key="RowGlyphSize">22</sys:Double>
        <sys:Double x:Key="RowRankFont">13.5</sys:Double>
        <sys:Double x:Key="RowAccentWidth">3</sys:Double>

        <!-- A soft dark halo under every text so it stays readable over any game scene -->
        <DropShadowEffect x:Key="TextShadow" BlurRadius="4" ShadowDepth="1" Direction="300" Opacity="0.9" Color="Black" />

        <!-- DPS: the figure that matters, white and a little bolder -->
        <Style x:Key="RowNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowNumberFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="{DynamicResource ColGap}" />
        </Style>

        <!-- Total damage and share: smaller and softer than the DPS -->
        <Style x:Key="RowSub" TargetType="TextBlock" BasedOn="{StaticResource RowNumber}">
            <Setter Property="FontSize" Value="{DynamicResource RowSubFont}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#C4CBD8" />
        </Style>

        <!-- Gear score and combat power: "GS 2822  CP 50.5K" — a light label and a bold coloured value, one size and one
             baseline, no box (a box crowds a slim row); the row's text shadow keeps them readable on any class colour -->
        <Style x:Key="GearText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowGearFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,1" />
        </Style>

        <!-- The hover toolbar's buttons: clear, high-contrast icon chips that stay legible over the game. -->
        <Style x:Key="ToolIcon" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
            <!-- A 1/255-alpha hit surface keeps layered-window icon buttons clickable over fully transparent areas. -->
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ToolbarChip" TargetType="ButtonBase" BasedOn="{StaticResource Chip}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="BorderBrush" Value="#493B39" />
            <Setter Property="Background" Value="#211D20" />
            <Setter Property="Foreground" Value="#D4B29C" />
        </Style>

        <SolidColorBrush x:Key="Cream" Color="#E5E7EA" />
        <SolidColorBrush x:Key="Soft" Color="#B4B8BE" />
        <SolidColorBrush x:Key="SelfGold" Color="#F28A45" />
        <SolidColorBrush x:Key="StatsTeal" Color="#50D6CF" />

        <!-- A hairline frame, a touch lighter at the top -->
        <LinearGradientBrush x:Key="CardFrame" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0" />
            <GradientStop Color="#1AFFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HpFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D97438" Offset="0" />
            <GradientStop Color="#F28A45" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="FooterLink" TargetType="Button">
            <Setter Property="Foreground" Value="#F28A45" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="P" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E5E7EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterAction" TargetType="Button">
            <Setter Property="Foreground" Value="#C5CBD0" />
            <Setter Property="Background" Value="#171A1F" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#282126" />
                                <Setter Property="Foreground" Value="#E5E7EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The footer's boss timer button: a quiet outlined pill, still plainly a button -->
        <Style x:Key="TimersPill" TargetType="Button">
            <Setter Property="Foreground" Value="#F28A45" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Padding="8,2,9,2" BorderThickness="1" BorderBrush="#66F06A22" Background="#1AF06A22">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F06A22" />
                                <Setter TargetName="Bd" Property="Background" Value="#33F06A22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "A new version is out": a slim ember banner above the footer, only while an update is available -->
        <Style x:Key="UpdateBannerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E5E7EA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="9,3,9,3" BorderThickness="1" BorderBrush="#80F06A22" Background="#2AF06A22">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F06A22" />
                                <Setter TargetName="Bd" Property="Background" Value="#40F06A22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One player: a slim bar in the class colour fading out towards its tip, a strip of that colour at the left edge,
             the place, emblem, name with gear score and combat power, then DPS, total damage and share -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:RowViewModel}">
            <Grid Height="{DynamicResource RowHeight}" Margin="{DynamicResource RowMargin}" Cursor="Hand" ToolTip="{Binding Tooltip}"
                  Background="Transparent" MouseLeftButtonUp="Row_Click" MouseRightButtonUp="Row_RightClick">
                <Border x:Name="Track" Background="#181A2028" CornerRadius="3" />
                <Grid Margin="8,0,10,0" Effect="{StaticResource TextShadow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Dps" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Share" />
                    </Grid.ColumnDefinitions>
                    <!-- Only the identity area carries the class-coloured relative bar. -->
                    <Border Background="{Binding SoftFillBrush}" CornerRadius="3" HorizontalAlignment="Left" Margin="-8,0,0,0">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource OverlayDisplay}">
                                <Binding Path="Fill" />
                                <Binding Path="DataContext.Rows[0].Fill" RelativeSource="{RelativeSource AncestorType=Window}" />
                                <Binding Path="ColumnDefinitions[0].ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource ColGlyphWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <c:ClassGlyph Class="{Binding Class}" OnBar="True" Width="{DynamicResource RowGlyphSize}"
                                      Height="{DynamicResource RowGlyphSize}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="{DynamicResource RowNameFont}" FontWeight="Bold"
                                       Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource GearText}" Margin="0">
                                <Run Text="✦ " Foreground="#AFBBC5" /><Run Text="{Binding Damage, Mode=OneWay}" Foreground="#BFCBD2" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Dps, Converter={StaticResource OverlayDisplay}}" Style="{StaticResource RowNumber}" Margin="0" />
                        <TextBlock Text="{Binding Damage}" Style="{StaticResource RowSub}" Margin="0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Share}" Style="{StaticResource RowSub}" Foreground="#75E5A1" MinWidth="48" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="#F21F1C1D" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter TargetName="NameText" Property="Foreground" Value="White" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Border x:Name="Frame" CornerRadius="5" BorderThickness="0" BorderBrush="Transparent"
                RenderTransformOrigin="0,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="FrameScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.Background>
                <SolidColorBrush x:Name="FrameBackground" Color="#090E14" Opacity="0.72" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <!-- Aetherion signature line: a restrained silver-to-ember sweep anchors the card without cluttering fight data. -->
        <Border x:Name="SignatureLine" Height="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E5E7EA" Offset="0" />
                    <GradientStop Color="#F28A45" Offset="0.48" />
                    <GradientStop Color="#7A3C22" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="CardBody" Margin="12,8,12,8" RenderTransformOrigin="0,0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CardBodyScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Compact statistics header; actions retain their existing handlers. -->
            <Grid x:Name="Header" Background="Transparent" Height="32">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DPS-Statistiken" Foreground="{StaticResource StatsTeal}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Clock, Converter={StaticResource OverlayDisplay}, ConverterParameter=clock}" FontFamily="{StaticResource NumberFont}" Foreground="#DAE6EA" FontSize="12" Margin="10,1,0,0" />
                </StackPanel>
                <StackPanel x:Name="CompactTopActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CompactResetButton" Style="{StaticResource ToolIcon}" Content="&#xE72C;" Click="Restart_Click" ToolTip="DPS zurücksetzen" AutomationProperties.Name="DPS zurücksetzen" />
                    <Button x:Name="CompactSettingsButton" Style="{StaticResource ToolIcon}" Content="&#xE713;" Click="Settings_Click" ToolTip="Einstellungen" AutomationProperties.Name="Einstellungen" />
                    <Button x:Name="CloseMeterButton" Style="{StaticResource ToolIcon}" Content="&#xE711;" Click="CloseMeter_Click" ToolTip="DPS Meter schließen" AutomationProperties.Name="DPS Meter schließen" />
                </StackPanel>
                <StackPanel Visibility="Collapsed"><TextBlock x:Name="PartnerBadge" /><Ellipse x:Name="StatusDot" /></StackPanel>
            </Grid>

            <!-- Boss health: separate label row and inset track keep text crisp and the fill easy to read. -->
            <Border x:Name="BossHealthPanel" Grid.Row="1" Margin="0,5,0,0" Padding="8,4,8,5" CornerRadius="6"
                    Background="#F0121216" BorderBrush="#493B39" BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="{Binding BossHpText}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="9"
                                   Foreground="#D9DADD" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BossPercent}" FontFamily="{StaticResource NumberFont}" FontWeight="Bold" FontSize="9"
                                   Foreground="#F2A06B" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid x:Name="BossHealthTrack" Grid.Row="1" ClipToBounds="True" Background="#383337">
                        <Border CornerRadius="3" Background="{StaticResource HpFill}" HorizontalAlignment="Stretch"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding BossHpFraction}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Group output at a glance -->
            <Grid Grid.Row="2" Height="0" Margin="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border x:Name="GroupDpsCard" Background="#121216" BorderBrush="#393337" BorderThickness="1" CornerRadius="8" Padding="10,7">
                    <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#F28A45" Width="3" Height="9" Margin="0,0,6,0" /><TextBlock Text="{Binding T.GroupDps}" FontSize="8" FontWeight="Bold" Foreground="#B4B8BE" /></StackPanel>
                        <TextBlock Text="{Binding PartyDps}" FontFamily="{StaticResource NumberFont}" FontSize="22" FontWeight="ExtraBold" Foreground="#F0F1F2" />
                    </StackPanel>
                </Border>
                <Border x:Name="GroupHpsCard" Grid.Column="2" Background="#121216" BorderBrush="#393337" BorderThickness="1" CornerRadius="8" Padding="10,7">
                    <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#C3C5C9" Width="3" Height="9" Margin="0,0,6,0" /><TextBlock Text="{Binding T.GroupHps}" FontSize="8" FontWeight="Bold" Foreground="#B4B8BE" /></StackPanel>
                        <TextBlock Text="{Binding PartyHps}" FontFamily="{StaticResource NumberFont}" FontSize="22" FontWeight="ExtraBold" Foreground="#E5E7EA" /></StackPanel>
                </Border>
            </Grid>

            <!-- Party: the rows share their value column widths -->
            <Grid Grid.Row="3" Margin="0,7,0,0" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- No column labels (the numbers read by themselves: 738K/s, 14.58M, 22.5 %): this empty grid only tells
                     OverlayWindow.FitNames how wide the rows' columns are -->
                <Grid x:Name="ColumnLabels" Height="0" Margin="10,0,12,0">
                    <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="28" />
                     <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <Grid Grid.Row="0" Margin="0,0,10,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="RANG · SPIELER" FontSize="8" FontWeight="Bold" Foreground="#91A3A9" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="DPS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource StatsTeal}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="4" Text="%" FontSize="8" FontWeight="Bold" Foreground="{StaticResource StatsTeal}" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer x:Name="PlayerRowsViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Padding="8,0,7,0" Margin="-8,0,-7,0" PreviewMouseWheel="Rows_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                </ScrollViewer>
                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330"
                            Visibility="{Binding HasData, Converter={StaticResource VisibleIf}, ConverterParameter=!}">
                    <TextBlock Text="{Binding T.EmptyParty}" FontSize="13" Foreground="#B4B8BE"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding WaitingPlayer}" FontSize="12" Foreground="#F28A45"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <Border x:Name="ToolbarTray" Visibility="Collapsed" Background="#010C0C0F" BorderBrush="Transparent" BorderThickness="0" CornerRadius="4" Padding="4" Margin="0,0,0,6">
                    <StackPanel x:Name="Toolbar" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button Style="{StaticResource ToolbarChip}" Content="{Binding ModeLabel}" Click="Mode_Click" Margin="0,0,4,0" ToolTip="{Binding T.TipTargetMode}" />
                        <Button Style="{StaticResource ToolbarChip}" Content="{Binding RankingLabel}" Click="Ranking_Click" Margin="0,0,4,0" ToolTip="Switch DPS / HPS ranking" />
                        <Button Style="{StaticResource ToolbarChip}" Content="{Binding LanguageCode}" Click="Language_Click" Margin="0,0,4,0" ToolTip="{Binding T.SwitchLanguage}" />
                        <Button x:Name="CustomerToolsToolButton" Style="{StaticResource ToolIcon}" Content="&#xE890;" Click="CustomerTools_Click" ToolTip="Komfort &amp; Analyse" AutomationProperties.Name="Komfort und Analyse" />
                        <Button x:Name="StreamerToolButton" Style="{StaticResource ToolIcon}" Content="&#xE730;" Click="Streamer_Click" ToolTip="Streamer-Modus umschalten" AutomationProperties.Name="Streamer-Modus umschalten" />
                        <Button x:Name="ChatToolButton" Style="{StaticResource ToolIcon}" Content="&#xE72D;" Click="Chat_Click" ToolTip="{Binding T.TipChat}" />
                        <Button x:Name="MapToolButton" Style="{StaticResource ToolIcon}" Content="&#xE774;" Click="Map_Click" ToolTip="{Binding T.MapLabel}" />
                        <Button x:Name="GuideToolButton" Style="{StaticResource ToolIcon}" Content="&#xE8A7;" Click="Wakayashi_Click" ToolTip="Wakayashi.gg in eigenem Fenster öffnen" />
                        <Button x:Name="TimersToolButton" Style="{StaticResource ToolIcon}" Content="&#xE121;" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" />
                        <Button x:Name="EventsToolButton" Style="{StaticResource ToolIcon}" Content="&#xE787;" Click="Events_Click" ToolTip="{Binding T.EventTimersTitle}" />
                        <ToggleButton x:Name="LockButton" Style="{StaticResource ToolToggle}" Click="Lock_Click" ToolTip="{Binding T.TipLock}"><TextBlock x:Name="LockGlyph" Text="&#xE785;" /></ToggleButton>
                        <Slider x:Name="OpacitySlider" Style="{StaticResource GoldSlider}" Width="52" Minimum="0" Maximum="1" Margin="5,0,3,0" ValueChanged="Opacity_Changed" VerticalAlignment="Center" ToolTip="{Binding T.TipOpacity}" />
                        <Button x:Name="HideToolButton" Style="{StaticResource ToolIcon}" Content="&#xE711;" Click="Hide_Click" ToolTip="{Binding T.TipHide}" />
                    </StackPanel>
                </Border>
                <!-- New version on GitHub: a slim banner until it is installed, skipped or closed for this session -->
                <Grid x:Name="UpdateBanner" Margin="0,0,0,6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource UpdateBannerButton}" Click="Update_Click" ToolTip="{Binding T.TipUpdate}">
                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Click="UpdateBannerClose_Click" Margin="4,0,8,0"
                            VerticalAlignment="Center" ToolTip="{Binding T.UpdateLater}" />
                </Grid>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="FooterStatus" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Status}">
                        <TextBlock Text="✦" FontSize="10" Foreground="{StaticResource StatsTeal}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding TotalDamage}" FontFamily="{StaticResource NumberFont}" FontSize="10" Foreground="#AFBBC5" />
                        <TextBlock x:Name="FooterText" Visibility="Collapsed" FontSize="11" Foreground="#A9B1C0" TextTrimming="CharacterEllipsis"
                                   Effect="{StaticResource TextShadow}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,35,0">
                        <Ellipse Width="5" Height="5" Fill="#F06A22" Margin="0,0,5,0" />
                        <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#F2A06B" />
                    </StackPanel>
                </Grid>
                <Border x:Name="FooterActions" Visibility="Collapsed" Background="#B90F1318" BorderBrush="#26323A43" BorderThickness="1" CornerRadius="8" Padding="4,3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FooterResetButton" Style="{StaticResource ToolIcon}" Content="&#xE72C;" Click="Restart_Click"
                                ToolTip="{Binding T.TipRestart}" AutomationProperties.Name="DPS zurücksetzen" Margin="0,0,4,0" />
                        <Button x:Name="FooterDetailsButton" Style="{StaticResource FooterAction}" Content="{Binding T.FooterDetailsLabel}" Click="Details_Click" />
                        <Button x:Name="FooterCompareButton" Style="{StaticResource FooterAction}" Content="{Binding T.FooterCompareLabel}" Click="Compare_Click" Margin="4,0,0,0" />
                        <Button x:Name="FooterSettingsButton" Style="{StaticResource ToolIcon}" Content="&#xE713;" Click="Settings_Click"
                                ToolTip="{Binding T.TipSettings}" AutomationProperties.Name="Einstellungen" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Resize grip -->
        <Thumb x:Name="ResizeGrip" Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
               Cursor="SizeNWSE" ToolTip="Fenstergröße ändern · am Eck ziehen" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="GripBack" Background="#D9111922" BorderBrush="#75F06A22" BorderThickness="1" CornerRadius="8">
                    <Path Data="M23 5 L5 23 M23 13 L13 23" Stroke="#FFE5E7EA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <!-- Separate edge handles let users change the width or height without also changing the other dimension. -->
        <Thumb x:Name="ResizeWidthGrip" Width="7" HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Margin="0,4,0,4" Background="#01000000" Cursor="SizeWE" Tag="width" ToolTip="Breite ändern" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Thumb.Template>
        </Thumb>
        <Thumb x:Name="ResizeHeightGrip" Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
               Margin="0,0,0,1" Cursor="SizeNS" Tag="height" ToolTip="Höhe ändern" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    </Grid>
</Window>
