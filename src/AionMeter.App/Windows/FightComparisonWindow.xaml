<Window x:Class="AionMeter.App.Windows.FightComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding CompareTitle, Source={x:Static s:UiText.Current}}" Width="760" Height="470" MinWidth="650" MinHeight="400"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Bg0}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding CompareTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="20" FontWeight="SemiBold" />
            <Grid Grid.Row="1" Margin="0,16,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel><TextBlock x:Name="FirstTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FirstMeta" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="8,0,0,0">
                    <StackPanel><TextBlock x:Name="SecondTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SecondMeta" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="8,0,8,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CompareMetric, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" />
                <TextBlock Grid.Column="1" Text="A" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="B" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding CompareDelta, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
            </Grid>
            <ItemsControl x:Name="ComparisonRows" Grid.Row="3">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="42" Margin="0,2,0,2">
                            <Border Background="#0AFFFFFF" CornerRadius="6" />
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Metric}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding First}" VerticalAlignment="Center" TextAlignment="Right" FontFamily="{StaticResource NumberFont}" />
                                <TextBlock Grid.Column="2" Text="{Binding Second}" VerticalAlignment="Center" TextAlignment="Right" FontFamily="{StaticResource NumberFont}" />
                                <TextBlock Grid.Column="3" Text="{Binding Change}" VerticalAlignment="Center" TextAlignment="Right" FontFamily="{StaticResource NumberFont}" Foreground="{StaticResource Gold}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Row="4" Content="{Binding Close, Source={x:Static s:UiText.Current}}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click" />
        </Grid>
    </Border>
</Window>
